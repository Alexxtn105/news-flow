@inherits LayoutComponentBase
@implements IDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!Auth.IsAuthenticated)
{
    @Body
}
else
{
    <MudLayout>
        <MudAppBar Elevation="0">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-3" Style="font-weight: 700; letter-spacing: -0.02em;">NewsFlow</MudText>
            <MudSpacer />
            <NewsFlow.Web.Components.Shared.NotificationBell />
            <MudTooltip Text="@(_isDarkMode ? "Светлая тема" : "Тёмная тема")">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="@ToggleTheme" />
            </MudTooltip>
            <MudText Typo="Typo.body2" Class="mr-3">@Auth.CurrentUser?.FullName</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="@Logout" />
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0">
            <MudNavMenu>
                <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Главная</MudNavLink>

                @if (Auth.HasRole("Translator"))
                {
                    <MudNavLink Href="/workspace/translator" Icon="@Icons.Material.Filled.Translate">Переводчик</MudNavLink>
                }
                @if (Auth.HasRole("Analyst"))
                {
                    <MudNavLink Href="/workspace/analyst" Icon="@Icons.Material.Filled.Analytics">Аналитик</MudNavLink>
                }
                <MudNavLink Href="/materials" Icon="@Icons.Material.Filled.Upload">Материалы</MudNavLink>
                @if (Auth.HasRole("Reviewer"))
                {
                    <MudNavLink Href="/workspace/reviewer" Icon="@Icons.Material.Filled.RateReview">Ревьюер</MudNavLink>
                }
                @if (Auth.HasRole("Registrar"))
                {
                    <MudNavLink Href="/workspace/registrar" Icon="@Icons.Material.Filled.AppRegistration">Регистратор</MudNavLink>
                }
                @if (Auth.HasRole("Controller"))
                {
                    <MudNavLink Href="/workspace/controller" Icon="@Icons.Material.Filled.FactCheck">Контролёр</MudNavLink>
                }
                @if (Auth.HasRole("Evaluator"))
                {
                    <MudNavLink Href="/workspace/evaluator" Icon="@Icons.Material.Filled.Star">Оценщик</MudNavLink>
                }

                @if (Auth.HasRole("Administrator"))
                {
                    <MudNavGroup Title="Админ" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                        <MudNavLink Href="/admin/users">Пользователи</MudNavLink>
                        <MudNavLink Href="/admin/sources">Источники</MudNavLink>
                        <MudNavLink Href="/admin/languages">Языки</MudNavLink>
                        <MudNavLink Href="/admin/countries">Страны</MudNavLink>
                        <MudNavLink Href="/admin/tags">Теги</MudNavLink>
                        <MudNavLink Href="/admin/audit-log">Журнал аудита</MudNavLink>
                        <MudNavLink Href="/admin/pipelines">Конвейеры</MudNavLink>
                    </MudNavGroup>
                }
            </MudNavMenu>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode = true;
    private bool _drawerOpen = true;

    private MudTheme _theme = new()
    {
        // --- Monokai Dark ---
        PaletteDark = new PaletteDark()
        {
            Black = "#1a1a2e",
            Background = "#272822",
            Surface = "#2d2e27",
            DrawerBackground = "#23241e",
            AppbarBackground = "#1e1f1c",
            Primary = "#66D9EF",
            Secondary = "#AE81FF",
            Tertiary = "#E6DB74",
            Info = "#66D9EF",
            Success = "#A6E22E",
            Warning = "#FD971F",
            Error = "#F92672",
            TextPrimary = "#F8F8F2",
            TextSecondary = "#90908a",
            ActionDefault = "#a8a8a2",
            DrawerText = "#F8F8F2",
            DrawerIcon = "#66D9EF",
            LinesDefault = "#3e3d32",
            TableLines = "#3e3d32",
            Divider = "#3e3d32",
            OverlayDark = "rgba(0,0,0,0.5)",
        },
        // --- Apple Light ---
        PaletteLight = new PaletteLight()
        {
            Black = "#1D1D1F",
            Background = "#F5F5F7",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            AppbarBackground = "#FBFBFD",
            AppbarText = "#1D1D1F",
            Primary = "#007AFF",
            Secondary = "#5856D6",
            Tertiary = "#FF9500",
            Info = "#007AFF",
            Success = "#34C759",
            Warning = "#FF9500",
            Error = "#FF3B30",
            TextPrimary = "#1D1D1F",
            TextSecondary = "#86868B",
            ActionDefault = "#8E8E93",
            DrawerText = "#1D1D1F",
            DrawerIcon = "#007AFF",
            LinesDefault = "#E5E5EA",
            TableLines = "#E5E5EA",
            Divider = "#E5E5EA",
            OverlayDark = "rgba(0,0,0,0.3)",
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "10px",
        },
        Typography = new Typography()
        {
            Default = new Default()
            {
                FontFamily = new[] { "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif" },
            }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        var mode = _isDarkMode ? "dark" : "light";
        await JS.InvokeVoidAsync("themeManager.set", mode);
    }

    private void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login");
    }

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string>("themeManager.get");
            var wantDark = saved != "light";
            if (wantDark != _isDarkMode)
            {
                _isDarkMode = wantDark;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}
