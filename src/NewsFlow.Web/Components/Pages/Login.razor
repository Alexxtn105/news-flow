@page "/login"
@page "/"
@rendermode InteractiveServer
@inject ISender Sender
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>NewsFlow — Вход</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center" Style="height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width: 100%;">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-6">NewsFlow</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-4" Color="Color.Secondary">
            Система обработки новостных материалов
        </MudText>

        <MudTextField @bind-Value="_username" Label="Логин" Variant="Variant.Outlined"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                      Class="mb-3" />

        <MudTextField @bind-Value="_password" Label="Пароль" Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                      Class="mb-4" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                   OnClick="HandleLogin" Disabled="_loading" Class="mb-2">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Войти
        </MudButton>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
    </MudPaper>
</MudContainer>

@code {
    private string _username = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/home");
    }

    private async Task HandleLogin()
    {
        _error = null;
        _loading = true;

        try
        {
            var result = await Sender.Send(
                new NewsFlow.Application.Auth.Commands.LoginCommand(_username, _password));
            Auth.Login(result.User);
            Snackbar.Add($"Добро пожаловать, {result.User.FullName}!", Severity.Success);
            Nav.NavigateTo("/home");
        }
        catch (UnauthorizedAccessException)
        {
            _error = "Неверный логин или пароль";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
