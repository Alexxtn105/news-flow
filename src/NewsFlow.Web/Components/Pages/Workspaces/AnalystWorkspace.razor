@page "/workspace/analyst"
@rendermode InteractiveServer
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS

<PageTitle>Аналитик</PageTitle>

<div class="analyst-workspace">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6" Style="color:#3b82f6; text-transform:uppercase; letter-spacing:0.08em; font-size:0.95rem;">
            Рабочее место аналитика
        </MudText>
        <MudSpacer />
        @if (_basket.Count > 0 && _mode == WorkMode.Material)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                     Style="font-size:0.7rem; height:20px;">
                В документ: @_basket.Count мат.
            </MudChip>
        }
        <MudTooltip Text="Обновить">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RefreshAll"
                           Color="Color.Primary" />
        </MudTooltip>
    </MudStack>

    <MudGrid Spacing="2">
        @* === LEFT: Tabs (Materials queue + My documents) === *@
        <MudItem xs="12" md="3">
            <MudPaper Class="panel-compact" Elevation="0" Style="background:#141414; border:1px solid #1e1e1e; height:calc(100vh - 160px); overflow-y:auto;">
                <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                         PanelClass="pa-0" Style="background:transparent;"
                         ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChanged">
                    <MudTabPanel Text="Материалы" Icon="@Icons.Material.Filled.Article" Style="font-size:0.75rem;">
                        <MudTable T="NewsFlow.Application.Materials.DTOs.MaterialListItemDto"
                                  Items="_queue" Hover="true" Dense="true" Striped="true" FixedHeader="true"
                                  Loading="_loading" Breakpoint="Breakpoint.None"
                                  RowClassFunc="@((item, _) => GetMaterialRowClass(item))"
                                  OnRowClick="@(args => args.Item is not null ? SelectMaterial(args.Item) : Task.CompletedTask)"
                                  Style="background:transparent;">
                            <HeaderContent>
                                <MudTh>Материал</MudTh>
                                <MudTh Style="width:50px;">Прио</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="font-size:0.8rem; line-height:1.2;">
                                        @context.Title
                                        @if (context.Status == NewsFlow.Domain.Enums.MaterialStatus.InAnalysis)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                                     Style="font-size:0.6rem; height:16px; min-height:16px; margin-left:4px;">
                                                в работе
                                            </MudChip>
                                        }
                                        @if (_basket.Any(b => b.Id == context.Id))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success"
                                                     Style="font-size:0.6rem; height:16px; min-height:16px; margin-left:4px;">
                                                в док
                                            </MudChip>
                                        }
                                    </MudText>
                                    <MudText Typo="Typo.caption" Style="font-size:0.7rem; color:#888;">@context.Source</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="GetPriorityColor(context.Priority)"
                                             Style="font-size:0.65rem; height:18px; min-height:18px;">
                                        @GetPriorityLabel(context.Priority)
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.caption" Align="Align.Center" Style="color:#888;">Нет материалов</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>

                    <MudTabPanel Text="Документы" Icon="@Icons.Material.Filled.Description" Style="font-size:0.75rem;"
                                 BadgeData="@(_myDocs.Count > 0 ? _myDocs.Count.ToString() : null)"
                                 BadgeColor="Color.Info">
                        <MudTable T="NewsFlow.Application.Documents.DTOs.DocumentListItemDto"
                                  Items="_myDocs" Hover="true" Dense="true" Striped="true" FixedHeader="true"
                                  Breakpoint="Breakpoint.None"
                                  RowClassFunc="@((item, _) => item.Id == _editingDoc?.Id ? "selected-row" : "")"
                                  OnRowClick="@(args => args.Item is not null ? SelectDocument(args.Item) : Task.CompletedTask)"
                                  Style="background:transparent;">
                            <HeaderContent>
                                <MudTh>Документ</MudTh>
                                <MudTh Style="width:60px;">Статус</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Style="font-size:0.8rem; line-height:1.2;">@context.Title</MudText>
                                    <MudText Typo="Typo.caption" Style="font-size:0.7rem; color:#888;">
                                        @context.CreatedAt.ToString("dd.MM HH:mm")
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(context.Status == NewsFlow.Domain.Enums.DocumentStatus.ReturnedForRevision ? Color.Warning : Color.Info)"
                                             Style="font-size:0.6rem; height:16px; min-height:16px;">
                                        @(context.Status == NewsFlow.Domain.Enums.DocumentStatus.ReturnedForRevision ? "доработка" : "черновик")
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.caption" Align="Align.Center" Style="color:#888;">Нет документов</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </MudItem>

        @* === CENTER: Material text viewer === *@
        <MudItem xs="12" md="5">
            @if (_viewingMaterial != null)
            {
                <MudPaper Class="panel-compact" Elevation="0" Style="background:#141414; border:1px solid #1e1e1e; height:calc(100vh - 160px); overflow-y:auto;">
                    @* Material selector chips *@
                    @{
                        var chipMaterials = _mode == WorkMode.Material ? _basket : _docSourceMaterials;
                    }
                    @if (chipMaterials.Count > 1)
                    {
                        <div class="mb-2" style="display:flex; flex-wrap:wrap; gap:4px;">
                            @foreach (var mat in chipMaterials)
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Icon="@Icons.Material.Filled.Article"
                                         Color="@(mat.Id == _viewingMaterial.Id ? Color.Primary : Color.Default)"
                                         Variant="@(mat.Id == _viewingMaterial.Id ? Variant.Filled : Variant.Outlined)"
                                         Style="font-size:0.7rem; height:22px; cursor:pointer;"
                                         OnClick="@(() => ViewMaterial(mat))">
                                    @Truncate(mat.Title, 25)
                                </MudChip>
                            }
                        </div>
                        <MudDivider Class="mb-2" Style="border-color:#222;" />
                    }

                    @* Material header *@
                    <MudText Typo="Typo.body1" Style="font-weight:600; font-size:0.875rem;">@_viewingMaterial.Title</MudText>
                    <MudStack Row="true" Spacing="2" Class="mt-1 mb-2" AlignItems="AlignItems.Center">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                 Style="font-size:0.7rem; height:20px;">@_viewingMaterial.Source</MudChip>
                        @if (!string.IsNullOrEmpty(_viewingMaterial.Country))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                     Style="font-size:0.7rem; height:20px;">@_viewingMaterial.Country</MudChip>
                        }
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="GetPriorityColor(_viewingMaterial.Priority)"
                                 Style="font-size:0.7rem; height:20px;">@_viewingMaterial.Priority</MudChip>

                        @* Material action buttons (inline, compact) *@
                        @if (_mode == WorkMode.Material && _viewingMaterial.Status == NewsFlow.Domain.Enums.MaterialStatus.InAnalysis)
                        {
                            <MudSpacer />
                            @if (!_basket.Any(b => b.Id == _viewingMaterial.Id))
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddToBasket" Style="font-size:0.7rem; height:24px; text-transform:none;">
                                    В документ
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Remove"
                                           OnClick="RemoveFromBasket" Style="font-size:0.7rem; height:24px; text-transform:none;">
                                    Убрать
                                </MudButton>
                            }
                        }
                    </MudStack>

                    <MudDivider Class="my-1" Style="border-color:#222;" />

                    @* Translated text *@
                    <div class="text-field-compact">
                        <MudText Typo="Typo.caption" Style="color:#3b82f6; text-transform:uppercase; font-size:0.7rem;">Перевод</MudText>
                        <MudTextField Value="@_viewingMaterial.TranslatedText" Lines="8" ReadOnly="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Style="font-size:0.8125rem;" Class="mt-1" />
                    </div>

                    @* Original text (expandable) *@
                    <MudExpansionPanels Class="mt-2" Elevation="0">
                        <MudExpansionPanel Text="Оригинал" MaxHeight="200" Dense="true"
                                           Style="background:#1c1c1c; border:1px solid #222;">
                            <div class="text-field-compact">
                                <MudTextField Value="@_viewingMaterial.OriginalText" Lines="6" ReadOnly="true"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Style="font-size:0.8125rem;" />
                            </div>
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    @if (_viewingMaterial.Attachments.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2" Style="color:#3b82f6; text-transform:uppercase; font-size:0.7rem;">
                            Вложения (@_viewingMaterial.Attachments.Count)
                        </MudText>
                        @foreach (var att in _viewingMaterial.Attachments)
                        {
                            <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.AttachFile"
                                     Style="font-size:0.7rem; height:20px;" Class="mr-1">@att.FileName</MudChip>
                        }
                    }

                    @* Reviewer comments (when editing document) *@
                    @if (_mode == WorkMode.Document && _editingDoc != null && _editingDoc.Comments.Any())
                    {
                        <MudDivider Class="my-2" Style="border-color:#222;" />
                        <MudText Typo="Typo.caption" Style="color:#f59e0b; text-transform:uppercase; font-size:0.7rem;">
                            Замечания ревьюера
                        </MudText>
                        @foreach (var comment in _editingDoc.Comments.OrderByDescending(c => c.CreatedAt))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1" Style="font-size:0.8rem;">
                                @comment.Text
                                <MudText Typo="Typo.caption" Style="font-size:0.65rem;">
                                    — @comment.Author, @comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                </MudText>
                            </MudAlert>
                        }
                    }
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="0" Style="background:#141414; border:1px solid #1e1e1e; height:calc(100vh - 160px);"
                          Class="d-flex align-center justify-center">
                    <MudStack AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Style="color:#2a2a45;" />
                        <MudText Typo="Typo.caption" Style="color:#666;">Выберите материал или документ</MudText>
                    </MudStack>
                </MudPaper>
            }
        </MudItem>

        @* === RIGHT: Document editor === *@
        <MudItem xs="12" md="4">
            <MudPaper Class="panel-compact" Elevation="0" Style="background:#141414; border:1px solid #1e1e1e; height:calc(100vh - 160px); display:flex; flex-direction:column;">
                <MudText Typo="Typo.h6">
                    @(_mode == WorkMode.Document && _editingDoc != null ? "Редактирование документа" : "Новый документ")
                </MudText>

                @* Basket chips (new document mode) *@
                @if (_mode == WorkMode.Material && _basket.Count > 0)
                {
                    <div class="mb-2">
                        <MudText Typo="Typo.caption" Style="color:#3b82f6; text-transform:uppercase; font-size:0.7rem; margin-bottom:4px;">
                            Материалы для документа (@_basket.Count)
                        </MudText>
                        <div style="display:flex; flex-wrap:wrap; gap:4px;">
                            @foreach (var mat in _basket)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                                         OnClose="@(() => RemoveMaterialFromBasket(mat.Id))"
                                         OnClick="@(() => ViewMaterial(mat))"
                                         Style="font-size:0.7rem; height:22px; cursor:pointer;">
                                    @Truncate(mat.Title, 20)
                                </MudChip>
                            }
                        </div>
                    </div>
                }

                @* Source materials chips (edit document mode) *@
                @if (_mode == WorkMode.Document && _editingDoc != null && _docSourceMaterials.Count > 0)
                {
                    <div class="mb-2">
                        <MudText Typo="Typo.caption" Style="color:#3b82f6; text-transform:uppercase; font-size:0.7rem; margin-bottom:4px;">
                            Исходные материалы (@_docSourceMaterials.Count)
                        </MudText>
                        <div style="display:flex; flex-wrap:wrap; gap:4px;">
                            @foreach (var mat in _docSourceMaterials)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Article"
                                         OnClick="@(() => ViewMaterial(mat))"
                                         Style="font-size:0.7rem; height:22px; cursor:pointer;">
                                    @Truncate(mat.Title, 20)
                                </MudChip>
                            }
                        </div>
                    </div>
                }

                <div class="text-field-compact" style="flex:1; display:flex; flex-direction:column; overflow:hidden;">
                    <MudTextField @bind-Value="_docTitle" Label="Заголовок" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="mb-1" Style="font-size:0.8125rem;" />
                    <div style="flex:1; min-height:300px; display:flex; flex-direction:column;">
                        <BlazoredTextEditor @ref="_quillEditor" Placeholder="Текст документа...">
                            <ToolbarContent>
                                <select class="ql-header">
                                    <option selected></option>
                                    <option value="1"></option>
                                    <option value="2"></option>
                                    <option value="3"></option>
                                </select>
                                <span class="ql-formats">
                                    <button class="ql-bold"></button>
                                    <button class="ql-italic"></button>
                                    <button class="ql-underline"></button>
                                    <button class="ql-strike"></button>
                                </span>
                                <span class="ql-formats">
                                    <select class="ql-color"></select>
                                    <select class="ql-background"></select>
                                </span>
                                <span class="ql-formats">
                                    <button class="ql-list" value="ordered"></button>
                                    <button class="ql-list" value="bullet"></button>
                                    <button class="ql-indent" value="-1"></button>
                                    <button class="ql-indent" value="+1"></button>
                                </span>
                                <span class="ql-formats">
                                    <select class="ql-align"></select>
                                </span>
                                <span class="ql-formats">
                                    <button class="ql-blockquote"></button>
                                    <button class="ql-link"></button>
                                </span>
                                <span class="ql-formats">
                                    <button class="ql-clean"></button>
                                </span>
                            </ToolbarContent>
                            <EditorContent>
                                @((MarkupString)_docContent)
                            </EditorContent>
                        </BlazoredTextEditor>
                    </div>
                </div>

                @* === Action toolbar === *@
                <div class="toolbar-actions mt-2">
                    @if (_mode == WorkMode.Material)
                    {
                        @if (_viewingMaterial != null && _viewingMaterial.Status == NewsFlow.Domain.Enums.MaterialStatus.Translated)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="TakeForAnalysis">
                                Взять в анализ
                            </MudButton>
                        }

                        @if (_viewingMaterial != null && _viewingMaterial.Status == NewsFlow.Domain.Enums.MaterialStatus.InAnalysis)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       OnClick="@(() => ShowReasonDialog("Вернуть на перевод", ReturnToTranslation))">
                                На перевод
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       OnClick="@(() => ShowReasonDialog("Не представляет интереса", MarkNotOfInterest))">
                                Не интересен
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => ShowReasonDialog("Искажён", MarkDistorted))">
                                Искажён
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       OnClick="ReleaseFromAnalysis">
                                В очередь
                            </MudButton>
                        }

                        @if (_basket.Count > 0)
                        {
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="CreateDocument"
                                       Disabled="@(string.IsNullOrWhiteSpace(_docTitle))">
                                Создать документ (@_basket.Count)
                            </MudButton>
                        }
                    }
                    else if (_mode == WorkMode.Document && _editingDoc != null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="SaveDocument"
                                   Disabled="@(string.IsNullOrWhiteSpace(_docTitle))">
                            Сохранить
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   OnClick="SubmitForReview"
                                   Disabled="@(string.IsNullOrWhiteSpace(_docTitle))">
                            На ревью
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="ExportDocx">
                            DOCX
                        </MudButton>
                    }
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>

@code {
    private enum WorkMode { Material, Document }

    private List<NewsFlow.Application.Materials.DTOs.MaterialListItemDto> _queue = [];
    private List<NewsFlow.Application.Documents.DTOs.DocumentListItemDto> _myDocs = [];

    // Current material displayed in center panel
    private NewsFlow.Application.Materials.DTOs.MaterialDto? _viewingMaterial;

    // Basket: materials accumulated for new document creation
    private List<NewsFlow.Application.Materials.DTOs.MaterialDto> _basket = [];

    // Document editing
    private NewsFlow.Application.Documents.DTOs.DocumentDto? _editingDoc;
    private List<NewsFlow.Application.Materials.DTOs.MaterialDto> _docSourceMaterials = [];

    private string _docTitle = "";
    private string _docContent = "";
    private BlazoredTextEditor? _quillEditor;
    private bool _loading;
    private WorkMode _mode = WorkMode.Material;
    private int _activeTab = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueue();
        await LoadMyDocs();
    }

    private async Task RefreshAll()
    {
        await LoadQueue();
        await LoadMyDocs();
    }

    private async Task LoadQueue()
    {
        _loading = true;
        var result = await Sender.Send(new NewsFlow.Application.Materials.Commands.GetAnalystQueueQuery());
        _queue = result.Items.ToList();
        _loading = false;
    }

    private async Task LoadMyDocs()
    {
        _myDocs = (await Sender.Send(new NewsFlow.Application.Documents.Commands.GetMyDocumentsQuery())).ToList();
    }

    private void OnTabChanged(int index)
    {
        _activeTab = index;
        if (index == 0)
        {
            // Clear doc editing state, but preserve basket draft
            if (_editingDoc != null)
            {
                _docTitle = "";
                _docContent = "";
            }
            _editingDoc = null;
            _docSourceMaterials.Clear();
            _mode = WorkMode.Material;
            if (_basket.Count > 0 && _viewingMaterial == null)
                _viewingMaterial = _basket[0];
        }
        else
        {
            _mode = WorkMode.Document;
            _viewingMaterial = null;
        }
    }

    private async Task SelectMaterial(NewsFlow.Application.Materials.DTOs.MaterialListItemDto item)
    {
        var material = await Sender.Send(new NewsFlow.Application.Materials.Queries.GetMaterialByIdQuery(item.Id));
        _viewingMaterial = material;
        _editingDoc = null;
        _docSourceMaterials.Clear();
        _mode = WorkMode.Material;
    }

    private async Task SelectDocument(NewsFlow.Application.Documents.DTOs.DocumentListItemDto item)
    {
        _editingDoc = await Sender.Send(new NewsFlow.Application.Documents.Queries.GetDocumentByIdQuery(item.Id));
        _mode = WorkMode.Document;
        _docTitle = _editingDoc.Title;
        _docContent = _editingDoc.Content;

        // Load all source materials in a single query
        var materialIds = _editingDoc.SourceMaterials.Select(s => s.MaterialId).ToList();
        _docSourceMaterials = materialIds.Count > 0
            ? await Sender.Send(new NewsFlow.Application.Materials.Queries.GetMaterialsByIdsQuery(materialIds))
            : [];

        // Show first source material text
        _viewingMaterial = _docSourceMaterials.FirstOrDefault();
    }

    private void ViewMaterial(NewsFlow.Application.Materials.DTOs.MaterialDto material)
    {
        _viewingMaterial = material;
    }

    // === Basket operations ===

    private void AddToBasket()
    {
        if (_viewingMaterial == null) return;
        if (_basket.Any(b => b.Id == _viewingMaterial.Id)) return;
        _basket.Add(_viewingMaterial);
    }

    private void RemoveFromBasket()
    {
        if (_viewingMaterial == null) return;
        _basket.RemoveAll(b => b.Id == _viewingMaterial.Id);
    }

    private void RemoveMaterialFromBasket(Guid materialId)
    {
        _basket.RemoveAll(b => b.Id == materialId);
        if (_viewingMaterial?.Id == materialId)
            _viewingMaterial = _basket.FirstOrDefault();
    }

    // === Material actions ===

    private async Task TakeForAnalysis()
    {
        if (_viewingMaterial == null) return;
        try
        {
            _viewingMaterial = await Sender.Send(
                new NewsFlow.Application.Materials.Commands.TakeMaterialForAnalysisCommand(_viewingMaterial.Id));
            Snackbar.Add("Материал взят в анализ", Severity.Success);
            await LoadQueue();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task SyncEditorContent()
    {
        if (_quillEditor != null)
            _docContent = await _quillEditor.GetHTML();
    }

    private async Task CreateDocument()
    {
        if (_basket.Count == 0) return;
        try
        {
            await SyncEditorContent();
            var materialIds = _basket.Select(b => b.Id).ToList();
            var priority = _basket.Max(b => b.Priority);
            var doc = await Sender.Send(new NewsFlow.Application.Documents.Commands.CreateDocumentCommand(
                new NewsFlow.Application.Documents.DTOs.CreateDocumentDto(
                    _docTitle, _docContent, materialIds, priority)));
            Snackbar.Add($"Документ создан из {_basket.Count} материалов", Severity.Success);
            _basket.Clear();
            _viewingMaterial = null;
            _docTitle = "";
            _docContent = "";
            await LoadQueue();
            await LoadMyDocs();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task SaveDocument()
    {
        if (_editingDoc == null) return;
        try
        {
            await SyncEditorContent();
            _editingDoc = await Sender.Send(
                new NewsFlow.Application.Documents.Commands.UpdateDocumentContentCommand(
                    _editingDoc.Id, _docTitle, _docContent));
            Snackbar.Add("Документ сохранён", Severity.Success);
            await LoadMyDocs();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ExportDocx()
    {
        if (_editingDoc == null) return;
        try
        {
            await SyncEditorContent();
            await SaveDocument();
            var result = await Sender.Send(new NewsFlow.Application.Documents.Queries.ExportDocumentQuery(_editingDoc.Id));
            var base64 = Convert.ToBase64String(result.FileContent);
            await JS.InvokeVoidAsync("downloadFile", result.FileName,
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document", base64);
        }
        catch (Exception ex) { Snackbar.Add($"Ошибка экспорта: {ex.Message}", Severity.Error); }
    }

    private async Task SubmitForReview()
    {
        if (_editingDoc == null) return;
        try
        {
            await SyncEditorContent();
            await Sender.Send(new NewsFlow.Application.Documents.Commands.SubmitDocumentForReviewCommand(
                _editingDoc.Id, _docTitle, _docContent));
            Snackbar.Add("Документ отправлен на ревью", Severity.Success);
            _editingDoc = null;
            _docSourceMaterials.Clear();
            _viewingMaterial = null;
            _docTitle = "";
            _docContent = "";
            await LoadMyDocs();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

