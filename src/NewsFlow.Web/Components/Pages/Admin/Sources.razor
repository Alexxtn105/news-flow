@page "/admin/sources"
@rendermode InteractiveServer
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Источники</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Справочник источников</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreate" Class="mb-3">Добавить источник</MudButton>

<MudTable T="NewsFlow.Application.References.DTOs.SourceDto" Items="_items" Hover="true" Dense="true" Loading="_loading" Striped="true">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh>Тип</MudTh>
        <MudTh>Описание</MudTh>
        <MudTh Style="width:100px">Действия</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Type</MudTd>
        <MudTd>@context.Description</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<NewsFlow.Application.References.DTOs.SourceDto> _items = [];
    private bool _loading;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _items = await Sender.Send(new NewsFlow.Application.References.Queries.GetSourcesQuery());
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<SourceEditDialog>();
        var dialog = await DialogService.ShowAsync<SourceEditDialog>("Новый источник", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            var dto = (NewsFlow.Application.References.DTOs.CreateSourceDto)result.Data!;
            await Sender.Send(new NewsFlow.Application.References.Commands.CreateSourceCommand(dto));
            Snackbar.Add("Источник создан", Severity.Success);
            await Load();
        }
    }

    private async Task OpenEdit(NewsFlow.Application.References.DTOs.SourceDto item)
    {
        var parameters = new DialogParameters<SourceEditDialog>
        {
            { x => x.ItemId, item.Id },
            { x => x.Name, item.Name },
            { x => x.Type, item.Type ?? "" },
            { x => x.Description, item.Description ?? "" },
            { x => x.IsEdit, true }
        };
        var dialog = await DialogService.ShowAsync<SourceEditDialog>("Редактирование источника", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            var dto = (NewsFlow.Application.References.DTOs.UpdateSourceDto)result.Data!;
            await Sender.Send(new NewsFlow.Application.References.Commands.UpdateSourceCommand(item.Id, dto));
            Snackbar.Add("Источник обновлён", Severity.Success);
            await Load();
        }
    }

    private async Task Delete(NewsFlow.Application.References.DTOs.SourceDto item)
    {
        bool? confirmed = await DialogService.ShowMessageBox("Удаление", $"Удалить «{item.Name}»?", yesText: "Удалить", cancelText: "Отмена");
        if (confirmed == true)
        {
            await Sender.Send(new NewsFlow.Application.References.Commands.DeleteSourceCommand(item.Id));
            Snackbar.Add("Источник удалён", Severity.Success);
            await Load();
        }
    }
}
