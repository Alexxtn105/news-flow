<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Name" Label="Название" Variant="Variant.Outlined" Class="mb-2" />
        <MudTextField @bind-Value="Type" Label="Тип" Variant="Variant.Outlined" Class="mb-2" />
        <MudTextField @bind-Value="Description" Label="Описание" Variant="Variant.Outlined" Lines="3" Class="mb-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Отмена</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
            @(IsEdit ? "Сохранить" : "Создать")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid? ItemId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public bool IsEdit { get; set; }

    private void Cancel() => MudDialog.Cancel();

    private void Submit()
    {
        if (IsEdit)
            MudDialog.Close(DialogResult.Ok(new NewsFlow.Application.References.DTOs.UpdateSourceDto(Name, Description, Type)));
        else
            MudDialog.Close(DialogResult.Ok(new NewsFlow.Application.References.DTOs.CreateSourceDto(Name, Description, Type)));
    }
}
