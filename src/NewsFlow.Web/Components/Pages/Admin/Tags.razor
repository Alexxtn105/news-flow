@page "/admin/tags"
@rendermode InteractiveServer
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Теги</PageTitle>
<MudText Typo="Typo.h5" Class="mb-4">Справочник тегов</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreate" Class="mb-3">Добавить тег</MudButton>

<MudTable T="NewsFlow.Application.References.DTOs.TagDto" Items="_items" Hover="true" Dense="true" Loading="_loading" Striped="true">
    <HeaderContent>
        <MudTh>Название</MudTh>
        <MudTh>Категория</MudTh>
        <MudTh Style="width:100px">Действия</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Category</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEdit(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => Delete(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private IReadOnlyList<NewsFlow.Application.References.DTOs.TagDto> _items = [];
    private bool _loading;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _loading = true;
        _items = await Sender.Send(new NewsFlow.Application.References.Queries.GetTagsQuery());
        _loading = false;
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters<TagEditDialog>();
        var dialog = await DialogService.ShowAsync<TagEditDialog>("Новый тег", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            var dto = (NewsFlow.Application.References.DTOs.CreateTagDto)result.Data!;
            await Sender.Send(new NewsFlow.Application.References.Commands.CreateTagCommand(dto));
            Snackbar.Add("Тег создан", Severity.Success);
            await Load();
        }
    }

    private async Task OpenEdit(NewsFlow.Application.References.DTOs.TagDto item)
    {
        var parameters = new DialogParameters<TagEditDialog>
        {
            { x => x.Name, item.Name },
            { x => x.Category, item.Category ?? "" },
            { x => x.IsEdit, true }
        };
        var dialog = await DialogService.ShowAsync<TagEditDialog>("Редактирование тега", parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            var dto = (NewsFlow.Application.References.DTOs.UpdateTagDto)result.Data!;
            await Sender.Send(new NewsFlow.Application.References.Commands.UpdateTagCommand(item.Id, dto));
            Snackbar.Add("Тег обновлён", Severity.Success);
            await Load();
        }
    }

    private async Task Delete(NewsFlow.Application.References.DTOs.TagDto item)
    {
        bool? confirmed = await DialogService.ShowMessageBox("Удаление", $"Удалить тег «{item.Name}»?", yesText: "Удалить", cancelText: "Отмена");
        if (confirmed == true)
        {
            await Sender.Send(new NewsFlow.Application.References.Commands.DeleteTagCommand(item.Id));
            Snackbar.Add("Тег удалён", Severity.Success);
            await Load();
        }
    }
}
